MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/newsrep?retryWrites=true&w=majority
PORT=3000

# Optional: a simple shared secret so only your extension can write to the cache.
# Extension clients send this in the X-NewsRep-Secret header on POST requests.
# Leave blank to disable write-protection (fine for personal/small-group use).
WRITE_SECRET=